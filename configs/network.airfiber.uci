# ==============================================================================
# OpenWrt UCI Network Template for Jio AirFiber 5G WAN
# Hardware: Sercomm JIDU6401 / MediaTek Filogic 830 (MT7986)
# ==============================================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:db8:1::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# 802.1Q VLAN 1015 Device (Jio AirFiber 5G Public Internet Bearer)
# Untagged traffic is reserved for internal ODU/TR-069 management.
# Public Internet traffic REQUIRES 802.1Q tagged VLAN 1015 with MTU 1500.
# IMPORTANT: Jio ODU binds to the stock router hardware MAC address.
# Replace XX:XX:XX:XX:XX:XX with the MAC address printed on your stock Jio router sticker.
config device
	option name 'wan.1015'
	option type '8021q'
	option ifname 'wan'
	option vid '1015'
	option mtu '1500'
	option macaddr 'XX:XX:XX:XX:XX:XX'

# 5G WAN6 Interface (Dual-Stack IPv6 via DHCPv6-PD on VLAN 1015)
config interface 'wan6'
	option device 'wan.1015'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
	option delegate '1'
	option metric '10'
	# Disable unmanaged auto-464xlat interface to prevent route collisions with netifd clat
	option iface_464xlat '0'
	# Disable Jio's throttled/hijacked internal DNS (2405:200:800::11) and use clean high-speed resolvers
	option peerdns '0'
	list dns '2606:4700:4700::1111'
	list dns '2001:4860:4860::8888'
	list dns '1.1.1.1'
	list dns '8.8.8.8'

# 464XLAT CLAT Interface (Native netifd translator for IPv4 internet on Jio 5G)
config interface 'clat'
	option proto '464xlat'
	option tunlink 'wan6'
	option ip6prefix '64:ff9b::/96'
	option mtu '1460'
	option metric '10'
